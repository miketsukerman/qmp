# SPDX-License-Identifier: Apache-2.0
# Script mode (cmake -P): writes ${OUT} defining QMP_BUILD_ID as the short git commit hash,
# with "-dirty" appended when the tree has uncommitted changes, so every binary can print
# which code it was built from. Runs on every build (see the qmp_build_id target) but only
# rewrites the header when the id changed, so ninja's restat avoids needless recompiles.
#
# Also defines QMP_BUILD_VERSION (ADR-011): VERSION itself when HEAD is the release tag
# v<VERSION> and the tree is clean, otherwise VERSION plus SemVer build metadata:
#   0.3.0+4.g3cd249234123        4 commits after the tag
#   0.3.0+g3cd249234123          the tag does not exist (yet)
#   0.3.0+4.g3cd249234123.dirty  uncommitted changes
if(NOT DEFINED OUT OR NOT DEFINED SRC OR NOT DEFINED VERSION)
  message(FATAL_ERROR
    "usage: cmake -DOUT=<header> -DSRC=<source dir> -DVERSION=<x.y.z> -P QmpBuildId.cmake")
endif()

execute_process(COMMAND git -C "${SRC}" rev-parse --short=12 HEAD
                OUTPUT_VARIABLE _hash OUTPUT_STRIP_TRAILING_WHITESPACE
                RESULT_VARIABLE _rc ERROR_QUIET)
if(NOT _rc EQUAL 0 OR _hash STREQUAL "")
  set(_hash "unknown")
endif()

set(_dirty "")
execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no
                OUTPUT_VARIABLE _status RESULT_VARIABLE _rc ERROR_QUIET)
if(_rc EQUAL 0 AND NOT _status STREQUAL "")
  set(_dirty "-dirty")
endif()

set(_meta "")
if(NOT _hash STREQUAL "unknown")
  execute_process(COMMAND git -C "${SRC}" rev-list --count "v${VERSION}..HEAD"
                  OUTPUT_VARIABLE _count OUTPUT_STRIP_TRAILING_WHITESPACE
                  RESULT_VARIABLE _rc ERROR_QUIET)
  if(NOT _rc EQUAL 0 OR NOT _count MATCHES "^[0-9]+$")
    set(_meta "g${_hash}")
  elseif(NOT _count EQUAL 0)
    set(_meta "${_count}.g${_hash}")
  endif()
endif()
if(_dirty)
  if(_meta STREQUAL "")
    set(_meta "dirty")
  else()
    set(_meta "${_meta}.dirty")
  endif()
endif()
set(_build_version "${VERSION}")
if(NOT _meta STREQUAL "")
  set(_build_version "${VERSION}+${_meta}")
endif()

set(_content "/* SPDX-License-Identifier: Apache-2.0 */
/* Generated by cmake/QmpBuildId.cmake on every build; do not edit or commit. */
#ifndef QMP_BUILD_ID_H
#define QMP_BUILD_ID_H
#define QMP_BUILD_ID \"${_hash}${_dirty}\"
#define QMP_BUILD_VERSION \"${_build_version}\"
#endif
")

set(_old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT _content STREQUAL _old)
  file(WRITE "${OUT}" "${_content}")
endif()
